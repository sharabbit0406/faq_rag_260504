# ===== App =====
APP_ENV=development

# ===== Database (local docker-compose) =====
DATABASE_URL=postgresql+asyncpg://faqrag:faqrag_local@localhost:5432/faqrag

# ===== Google Cloud =====
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json   # path to service account JSON

# ===== Vertex AI =====
VERTEX_AI_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash-preview-05-20

# ===== Firebase Admin =====
FIREBASE_ADMIN_CREDENTIALS=./firebase-admin-key.json   # path to firebase admin JSON

# ===== Qdrant (use local docker for dev, cloud for prod) =====
# Local:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                       # empty for local
# Cloud (replace with your Qdrant Cloud values):
# QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

QDRANT_COLLECTION_NAME=faq_chunks

# ===== Google Cloud Storage =====
GCS_BUCKET_NAME=your-bucket-name

# ===== RAG =====
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
DEFAULT_DAILY_LLM_LIMIT=100
